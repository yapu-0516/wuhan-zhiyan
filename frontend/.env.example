# 复制为 .env.local 后按需修改

# 开发期后端地址（Vite 代理 /api /files /api/ws）
VITE_BACKEND=http://127.0.0.1:8000

# 'true' 时不请求后端，直接读取 public/snapshot 离线快照（静态托管 / GitHub Pages）
VITE_USE_MOCK=false

# 部署子路径，例如 GitHub Pages 项目页：/wuhan-zhiyan/
VITE_BASE=/

# 底图：dark（默认）| satellite | offline
VITE_BASEMAP=satellite

# 可选：Cesium Ion Token（启用 World Terrain 等在线服务）
VITE_CESIUM_ION_TOKEN=
